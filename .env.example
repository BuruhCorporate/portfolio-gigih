# Template of every environment variable this project reads.
#
# Where values come from, strongest first:
#   real environment variables      Vercel → Settings → Environment Variables, or `VITE_PROTECT=true npm run dev`
#   .env.development.local          your machine only, `npm run dev`            (not committed)
#   .env.production.local           your machine only, `npm run build`/preview  (not committed)
#   .env.development                committed default for `npm run dev`
#   .env.production                 committed default for `npm run build` and Vercel
# A plain .env.local loses to the two committed mode files, so use the mode-specific .local files above.
#
# Only VITE_* variables reach the browser bundle. Never put secrets here.

# Copy deterrents from src/lib/protect.ts: no right-click, devtools/save/print shortcuts,
# text selection or printing, and the page blurs on PrintScreen or when the tab loses focus.
# true = on, false = off. Changes need a dev-server restart or a new build.
VITE_PROTECT=false
